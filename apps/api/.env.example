# API runtime config — copy to .env.local for development; never commit secrets
NODE_ENV=development
# OCI_ENV=local activates the DevAuthGuard stub (no Cognito needed).
# Identity/roles come from the Bearer dev:<user>:<roles> sentinel token
# (set by the web app's local-mode Credentials provider) or the
# X-Dev-User / X-Dev-Roles headers (curl/Postman). CDK never sets
# OCI_ENV=local, so the bypass is unreachable in dev/int/prod.
OCI_ENV=local
PORT=3000

# Cognito (only used when OCI_ENV != local — values pulled from SSM at
# runtime in dev/int/prod; placeholders here keep the API booting).
COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXX
COGNITO_REGION=eu-central-1

# Postgres — matches infra/local/docker-compose.yml
DATABASE_URL=postgresql://oci:oci@localhost:5432/oci_dev

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# AWS (use IAM role / OIDC in real envs — never hard-code keys)
AWS_REGION=eu-central-1

# DocuSeal — AdES DUA signing (#128). Local-dev: bring up DocuSeal
# via `docker compose -f infra/local/docker-compose.yml up -d
# docuseal`, then follow the one-time admin/token bootstrap in the
# compose file. When all three are unset the signing endpoints
# return 503; the rest of the platform keeps working.
OCI_DOCUSEAL_BASE_URL=http://localhost:3010
OCI_DOCUSEAL_API_TOKEN=
OCI_DOCUSEAL_WEBHOOK_SECRET=local-dev-secret

# Sealed execution — Mode 2 / CONTAINER submissions (ADR-0017, ADR-0018).
# Unset OCI_EVAL_QUEUE_URL disables the CONTAINER path: the submission
# endpoint answers 503 instead of enqueueing into the void. Mode 1
# (predictions file) is unaffected either way.
#   OCI_API_URL                 absolute base URL of THIS api; used to build
#                               the worker's outbox callback URL.
#   OCI_EVAL_RUN_TIMEOUT_SEC    optional; hard wall-clock cap per sealed run.
#                               Default 1800. Must stay below the queue's
#                               visibility timeout.
#   SQS_ENDPOINT                localstack, for local development.
#   COGNITO_EVAL_WORKER_CLIENT_ID  Cognito machine-to-machine app-client id the
#                               worker authenticates with on the result outbox.
#   OCI_EVAL_WORKER_SCOPE       resource-server scope required on that token.
#                               Default oci-eval/submit-result.
OCI_EVAL_QUEUE_URL=
OCI_API_URL=http://localhost:3000
OCI_EVAL_RUN_TIMEOUT_SEC=
SQS_ENDPOINT=
COGNITO_EVAL_WORKER_CLIENT_ID=
OCI_EVAL_WORKER_SCOPE=

# Whole-dataset ZIP download — cap on the summed contentSizeBytes of the
# eligible distributions for `GET /v2/catalog/datasets/:slug/download`.
# Over the cap the request gets a 413 naming the total + the cap instead
# of streaming. Unset → 2 GiB. See docs/deployment.md.
OCI_BULK_DOWNLOAD_MAX_BYTES=2147483648
