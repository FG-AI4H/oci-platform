NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL — used server-side by lib/api.ts (Server
# Components / Actions). Same value as NEXT_PUBLIC_API_URL locally.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# OCI_ENV=local activates the local-dev NextAuth Credentials provider
# (id: 'cognito') so existing signIn('cognito') call sites keep working
# while skipping the real Hosted UI redirect. CDK never sets this in
# deployed envs; safe to delete in production.
OCI_ENV=local
NEXT_PUBLIC_OCI_ENV=local

# NextAuth session-encryption secret — anything stable for local dev.
# In dev/int/prod this is injected from Secrets Manager.
AUTH_SECRET=local-dev-only-do-not-use-in-prod
AUTH_URL=http://localhost:3001

# Cognito (only used when OCI_ENV != local — placeholders keep types happy)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_COGNITO_DOMAIN=oci-platform-dev.auth.eu-central-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REGION=eu-central-1
