NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL — used server-side by lib/api.ts (Server
# Components / Actions). Same value as NEXT_PUBLIC_API_URL locally.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Public canonical URL of the web app — drives `metadataBase`, the
# absolute URLs in JSON-LD `Dataset` blocks (Google Dataset Search),
# `sitemap.xml`, and `robots.txt`. Per env:
#   dev   → https://dev.oci.ai4h.net
#   int   → https://int.oci.ai4h.net
#   prod  → https://oci.ai4h.net
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# OCI_ENV=local activates the local-dev NextAuth Credentials provider
# (id: 'cognito') so existing signIn('cognito') call sites keep working
# while skipping the real Hosted UI redirect. CDK never sets this in
# deployed envs; safe to delete in production.
OCI_ENV=local
NEXT_PUBLIC_OCI_ENV=local

# NextAuth session-encryption secret — anything stable for local dev.
# In dev/int/prod this is injected from Secrets Manager.
AUTH_SECRET=local-dev-only-do-not-use-in-prod
AUTH_URL=http://localhost:3001

# Web session limits (ADR-0027). In dev/int/prod the idle limit is set by
# CDK from infra/cdk/lib/environments.ts. With OCI_ENV=local there is no
# idle limit unless one is set here; a deployed environment without the
# variable applies 30 minutes.
#   OCI_SESSION_IDLE_SECONDS            end the session after this long
#                                       without activity (1 to 86400)
#   OCI_SESSION_REFRESH_MARGIN_SECONDS  renew the access token when it has
#                                       this long left; default 300. Only
#                                       the end-to-end test changes it.
# OCI_SESSION_IDLE_SECONDS=
# OCI_SESSION_REFRESH_MARGIN_SECONDS=

# Cognito (only used when OCI_ENV != local — placeholders keep types happy)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_COGNITO_DOMAIN=oci-platform-dev.auth.eu-central-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REGION=eu-central-1
