{
  "name": "@oci/croissant",
  "version": "0.0.0",
  "private": true,
  "description": "Croissant 1.1 + RAI + BIOCroissant validator — layered Zod schemas with JSON-Pointer error reporting.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
