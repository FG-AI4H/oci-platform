{
  "name": "@oci/dicom",
  "version": "0.0.0",
  "private": true,
  "description": "Read DICOM headers without touching pixel data: instance metadata for the series index, slice ordering, and de-identification findings (ADR-0026). Pure functions — no DB, no Prisma, no network.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/test-support/build-part10.d.ts",
      "default": "./dist/test-support/build-part10.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "dicom-parser": "1.8.21"
  }
}
