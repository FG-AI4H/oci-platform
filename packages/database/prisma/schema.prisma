// OCI Platform — Prisma schema (Prisma 7 + multi-schema).
//
// Connection URL is supplied via `prisma.config.ts` (Migrate / Studio) and
// via `@prisma/adapter-pg` at application runtime (PrismaClient). The
// schema no longer embeds the `url` field — Prisma 7 dropped that.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "catalog", "annotation", "prediction", "evaluation", "reporting", "platform"]
}

// ==========================================================================
// identity — users, roles, organizations (DP package, WS-2)
// ==========================================================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  cognitoId String   @unique @map("cognito_id")
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@schema("identity")
}

// One row per user. `userId` is a soft FK onto `identity.users.id`
// (UUIDv5 derived from the Cognito sub via `subToUuid`); we don't
// declare a Prisma relation because most rows are created lazily on
// first preference read and pre-date the matching `users` row.
model UserPreferences {
  userId    String   @id @map("user_id") @db.Uuid
  darkMode  String   @default("system") @map("dark_mode")
  locale    String?
  density   String   @default("comfortable")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
  @@schema("identity")
}

/// Verified ORCID iD link (#125, ADR-0003 Phase 2). One row per user
/// — a Cognito identity has at most one linked ORCID. Re-linking
/// (different ORCID iD on the same account) updates the row in place.
///
/// `userId` is a soft FK → identity.users.id (UUIDv5 from Cognito sub
/// via subToUuid; same convention as other identity-schema rows).
///
/// `orcidId` is the canonical 16-digit form (e.g. `0000-0001-2345-6789`)
/// — that's the format ORCID returns in its OAuth `id_token`. Stored
/// without protocol prefix so `https://orcid.org/<id>` is reconstructed
/// at render time.
///
/// Identity-context normalizer reads `userId` to lift the score to
/// `ORCID_LINKED` when present (rank 2 — between EMAIL_DOMAIN_VERIFIED
/// and QUIZ_PASSED).
///
/// Storage hygiene: we deliberately DON'T persist the OAuth tokens.
/// The platform uses `/authenticate` scope only — the token is a
/// proof-of-link at consent time and isn't needed afterward. Skipping
/// it removes a credential-rotation surface and reduces blast radius
/// on a hypothetical breach.
model UserOrcidLink {
  /// Soft FK → identity.users.id; primary key here so a user has at
  /// most one ORCID link (uniqueness enforced by PK).
  userId       String   @id @map("user_id") @db.Uuid
  /// 16-digit ORCID iD with hyphens — `0000-0001-2345-6789`.
  orcidId      String   @unique @map("orcid_id")
  /// Display name as ORCID returned it. Free-form; not authoritative
  /// for any access-control decision.
  fullName     String?  @map("full_name")
  /// Verified primary email at ORCID. May differ from the user's
  /// platform email — that's fine; both are signal.
  primaryEmail String?  @map("primary_email")
  /// Most recent employment institution from the ORCID employment
  /// record. Used for the `affiliation` slot on `RequesterIdentityContext`.
  /// Free-form text; only updated on link / re-link.
  affiliation  String?
  /// When the link was first established. Renewed on every callback
  /// re-confirmation so a regulator can show "verified within last
  /// 90 days" if asked.
  verifiedAt   DateTime @default(now()) @map("verified_at")

  @@map("user_orcid_links")
  @@schema("identity")
}

/// GA4GH Passport trusted issuer registry (#126, ADR-0003 Phase 2).
/// Admin-managed allowlist of issuer URLs the platform will accept
/// Visa JWTs from. Each issuer publishes a JWKS at
/// `<issuer>/.well-known/jwks.json` (or the path declared in their
/// OIDC discovery doc); the verifier fetches + caches keys lazily.
///
/// Trust roots seeded at deploy time (per `docs/passport-trust-list.md`):
///   - https://login.elixir-czech.org/oidc/   (ELIXIR AAI — bioscience federation)
///   - https://stsstg.nih.gov/                 (NIH RAS — researcher authentication)
///
/// Disabling an issuer doesn't delete past visas; their `verified` state
/// is recomputed at next ingest. `revokedAt` is admin-set: a hard kill
/// switch when an issuer is compromised — visas signed by that issuer
/// fail verification regardless of expiry.
model PassportTrustedIssuer {
  id          String    @id @default(uuid()) @db.Uuid
  /// Issuer URL — stable identifier from the `iss` JWT claim. Must end
  /// without trailing slash to match the JWT claim verbatim.
  issuer      String    @unique
  /// Human label shown in the host inbox alongside ingested visas
  /// (e.g. "ELIXIR AAI", "NIH RAS").
  displayName String    @map("display_name")
  /// Optional override for the JWKS URI. When null, the verifier
  /// derives `<issuer>/.well-known/jwks.json` (Passport spec default).
  jwksUri     String?   @map("jwks_uri")
  /// Set when the issuer is taken out of trust — visas signed by
  /// this issuer will fail verification. Audit history preserved.
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("passport_trusted_issuers")
  @@schema("identity")
}

/// Verified GA4GH Visa (#126, ADR-0003 Phase 2). One row per
/// (user, issuer, visaType, jti). The same user might hold a
/// `ResearcherStatus` from ELIXIR and an `AffiliationAndRole` from
/// NIH — both rows persist independently.
///
/// `userId` is a soft FK → identity.users.id (UUIDv5 from Cognito sub
/// via subToUuid; same convention as other identity-schema rows).
///
/// Verification is performed at ingest: the JWT is validated against
/// the issuer's JWKS (signature + iss + exp + nbf) and the trusted-
/// issuer registry. Stored only on success.
///
/// `payload` carries the decoded `ga4gh_visa_v1` claim verbatim
/// (`{ type, asserted, value, source, by? }`) for audit. The shape is
/// fixed by the GA4GH spec; we don't normalise its sub-fields beyond
/// extracting `visaType` for the index.
///
/// `expiresAt` mirrors the JWT `exp` claim. Identity-context queries
/// filter by `expiresAt > now()` so expired visas drop off without
/// requiring a delete pass.
///
/// `revokedAt` is set when the user explicitly removes a visa via
/// `/me/passport/visas/:id` DELETE; soft-delete preserves the audit
/// trail (regulators can still see what was once verified).
model UserPassportVisa {
  id         String    @id @default(uuid()) @db.Uuid
  /// Soft FK → identity.users.id.
  userId     String    @map("user_id") @db.Uuid
  /// Trusted issuer URL the JWT was signed by — `iss` claim.
  issuer     String
  /// GA4GH Visa type — typically one of: `ResearcherStatus`,
  /// `AffiliationAndRole`, `AcceptedTermsAndPolicies`,
  /// `ControlledAccessGrants`, `LinkedIdentities`.
  visaType   String    @map("visa_type")
  /// JWT `jti` (or generated id when issuer omits it). Used to
  /// detect re-ingest of the same visa idempotently.
  jti        String
  /// Decoded `ga4gh_visa_v1` claim — shape: `{ type, asserted, value, source, by? }`.
  payload    Json
  /// JWT `iat` claim — when the issuer asserted.
  assertedAt DateTime  @map("asserted_at")
  /// JWT `exp` claim — when the visa stops being trusted.
  expiresAt  DateTime  @map("expires_at")
  /// Server-side timestamp of successful verification + ingest.
  verifiedAt DateTime  @default(now()) @map("verified_at")
  /// Soft-delete: user-initiated removal. Preserves audit trail.
  revokedAt  DateTime? @map("revoked_at")

  @@unique([userId, issuer, visaType, jti])
  @@index([userId, expiresAt])
  @@index([visaType])
  @@map("user_passport_visas")
  @@schema("identity")
}

/// Visas issued by THIS platform (#127, ADR-0003 Phase 2). One row per
/// visa minted for a user — `AcceptedTermsAndPolicies` on click-wrap,
/// `ResearcherStatus` on quiz pass, `ControlledAccessGrants` on AR
/// approval. The signed JWT is regenerable on demand from the row +
/// the active signing key, so we don't persist the JWT itself —
/// callers fetch a fresh JWT via the issued-visas endpoint.
///
/// `kid` records which signing key produced the visa so a verifier
/// (us or anyone else fetching `/.well-known/jwks.json`) can
/// disambiguate when key rotation overlaps active visas.
///
/// Why a separate table from `user_passport_visas`: the relying-party
/// table holds *external* visas we ingested and verified; this table
/// holds *internal* visas we issued. A self-loop where we ingest our
/// own visas would be circular — internal visas are surfaced directly
/// from this table on the identity-context lift path.
model IssuedPassportVisa {
  id          String    @id @default(uuid()) @db.Uuid
  /// Soft FK → identity.users.id (UUIDv5 from Cognito sub via subToUuid).
  userId      String    @map("user_id") @db.Uuid
  /// Visa type — one of: ResearcherStatus, AffiliationAndRole,
  /// AcceptedTermsAndPolicies, ControlledAccessGrants. Strictly the
  /// GA4GH-spec set; custom types (`BuilderStatus`) require an
  /// extension proposal first per ADR-0003 Phase 3.
  visaType    String    @map("visa_type")
  /// `value` field of the `ga4gh_visa_v1` claim — issuer-defined.
  /// For ResearcherStatus: the certification slug (`data_ethics_v1`).
  /// For ControlledAccessGrants: the dataset slug or DOI.
  /// For AcceptedTermsAndPolicies: the policy URL.
  value       String
  /// `source` of the assertion — typically the OCI issuer URL.
  source      String
  /// JWT id — generated at mint time. Stable across re-issuance of
  /// the same logical visa (e.g. if we re-mint with a new key the
  /// jti stays so verifiers can dedupe).
  jti         String    @unique
  /// Key id of the signing key used at mint time. References
  /// `passport_signing_keys.kid`.
  kid         String
  /// JWT `iat` — when we asserted.
  assertedAt  DateTime  @map("asserted_at")
  /// JWT `exp` — when verifiers should stop trusting.
  expiresAt   DateTime  @map("expires_at")
  /// Soft-delete: admin-side revocation (e.g. ToU breach). Visa fails
  /// verification once set; the verifier checks the issued-visa
  /// table before trusting our own signatures.
  revokedAt   DateTime? @map("revoked_at")
  /// Optional foreign reference for audit. e.g.
  /// `(contextType=access_request, contextRef=<request id>)`.
  contextType String?   @map("context_type")
  contextRef  String?   @map("context_ref")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, visaType, expiresAt])
  @@index([contextType, contextRef])
  @@map("issued_passport_visas")
  @@schema("identity")
}

/// Passport signing key registry (#127, ADR-0003 Phase 2). Tracks
/// the signing keys the platform uses to mint visas. The `kid` is
/// published in the JWKS endpoint so verifiers can pick the right
/// public key.
///
/// Two activation modes (mutually exclusive — set one of):
///   - KMS: `kmsKeyArn` set; the server signs via `KMS:Sign`.
///   - Local-dev: `privateKeyPem` set; in-memory signing only.
///                Operators must NOT use this in prod; the env-loader
///                refuses to enable local-dev signing when NODE_ENV=production.
///
/// `publicJwk` is the spec-shape JWK (`{ kty, n, e, alg, kid, use }`).
/// Cached on the row so the JWKS endpoint doesn't hit KMS on every
/// request. Refreshed when the row is rotated.
///
/// Status lifecycle: ACTIVE → RETIRED. Retired keys stay in the JWKS
/// for one rotation window so previously-minted visas keep verifying
/// until they expire. `archivedAt` deletes from JWKS at the next
/// pickup.
model PassportSigningKey {
  /// Key id — opaque short string used in JWT header. Generated at
  /// rotate-time. e.g. `oci-issuer-2026-05-09`.
  kid           String    @id
  /// JWS algorithm — one of: RS256, ES256. RS256 is the default for
  /// KMS RSA keys (`RSASSA_PKCS1_V1_5_SHA_256`).
  alg           String
  /// AWS KMS key ARN. Mutually exclusive with `privateKeyPem`.
  kmsKeyArn     String?   @map("kms_key_arn")
  /// Local-dev private key PEM. Refused in production. Mutually
  /// exclusive with `kmsKeyArn`.
  privateKeyPem String?   @map("private_key_pem")
  /// JWK shape `{ kty, n, e, alg, kid, use:'sig' }` — published.
  publicJwk     Json      @map("public_jwk")
  /// ACTIVE keys are used for new signs; RETIRED keys stay in JWKS
  /// until `archivedAt`.
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at")
  retiredAt     DateTime? @map("retired_at")
  archivedAt    DateTime? @map("archived_at")

  @@map("passport_signing_keys")
  @@schema("identity")
}

/// Certification quiz attempt (#117, ADR-0003 Phase 1). One row per
/// attempt. An attempt is a unit of: requester opens the quiz, picks
/// answers, submits. We store every attempt — including failed ones —
/// for the audit trail; an "active certification" is the most recent
/// passed attempt within the last year (per
/// `OCI_QUIZ_VALIDITY_DAYS`, default 365).
///
/// `userId` is a soft FK → identity.users.id (UUIDv5 from Cognito sub
/// via subToUuid; same convention as other identity-schema rows).
///
/// `certificationType` is a versioned slug (`data_ethics_v1`,
/// `data_ethics_v2`, …). New versions get a new slug; old passes keep
/// their type so a cert under v1 still proves "the user passed v1".
/// The active-certification check matches against the *current* type
/// from the questions file, so bumping the version invalidates older
/// passes.
///
/// `answers` carries the raw responses for audit; never surfaced to
/// the requester after submission (we don't reveal which answers were
/// wrong since the question pool is small and re-attempts would game
/// quickly). Schema: `[{ questionId, choiceIndex }]`.
model QuizAttempt {
  id                String    @id @default(uuid()) @db.Uuid
  /// Soft FK → identity.users.id.
  userId            String    @map("user_id") @db.Uuid
  /// Versioned quiz type slug — see schema docs.
  certificationType String    @map("certification_type")
  /// Server-side timestamp the attempt began.
  startedAt         DateTime  @default(now()) @map("started_at")
  /// `null` until the attempt is submitted (or abandoned). The audit
  /// trail keeps even abandoned attempts so we can detect grinding.
  submittedAt       DateTime? @map("submitted_at")
  /// 0–100. `null` until submission.
  score             Int?
  /// `null` until submission. After: pass-mark is per quiz definition;
  /// a passed attempt within `OCI_QUIZ_VALIDITY_DAYS` is the active
  /// certification.
  passed            Boolean?
  /// `[{ questionId: string, choiceIndex: number }, ...]`. Stored
  /// verbatim from the request body; the service grades on submission.
  answers           Json?

  @@index([userId, certificationType, submittedAt(sort: Desc)])
  @@map("quiz_attempts")
  @@schema("identity")
}

/// Click-wrap policy acceptance (#118, ADR-0003 Decision 4). One row
/// per acceptance event; stores the policy text verbatim + its SHA-256
/// hash so we can re-verify the binding even if the canonical policy
/// document is later updated. Legally sufficient for SES (Simple
/// Electronic Signature) tier under US ESIGN/UETA + EU eIDAS.
///
/// `userId` is a soft FK → identity.users.id (UUIDv5 from Cognito sub
/// via subToUuid; same convention as UserPreferences).
///
/// `receiptSignature` is optional — when AWS KMS signing is configured
/// (env `OCI_KMS_SIGNING_KEY_ARN`) the API signs a receipt blob
/// (`{ id, userId, policyUrl, policyVersion, textSha256, acceptedAt }`)
/// and stores the base64 signature. Tamper-evidence beyond the simple
/// hash; a regulator audit can later present the receipt + signature
/// to KMS Verify and confirm authenticity. Null on rows where KMS
/// wasn't configured at acceptance time.
model PolicyAcceptance {
  id               String   @id @default(uuid()) @db.Uuid
  /// Soft FK → identity.users.id.
  userId           String   @map("user_id") @db.Uuid
  /// Canonical URL for the policy document (e.g. https://oci.ai4h.net/policies/dua-research-v1).
  policyUrl        String   @map("policy_url")
  /// Version slug shown in the policy header (e.g. "v1.0", "2026-05"),
  /// surfaced in the audit trail so a regulator can map the acceptance
  /// to the canonical text-of-record at the time.
  policyVersion    String   @map("policy_version")
  /// Verbatim policy text the user clicked to accept. Stored so the
  /// hash can be re-derived and so audit trails don't depend on the
  /// canonical URL still resolving years later.
  policyText       String   @map("policy_text")
  /// Lower-case hex SHA-256 of `policyText`. The actual binding
  /// artifact the API emits to caller as a receipt.
  textSha256       String   @map("text_sha256") @db.Char(64)
  /// Optional foreign reference: which workflow this acceptance
  /// belongs to. e.g. `contextType=access_request, contextRef=<request id>`.
  /// `null` for top-level platform-ToU acceptances.
  contextType      String?  @map("context_type")
  contextRef       String?  @map("context_ref")
  /// KMS-signed receipt blob (base64 DER). Null when KMS signing was
  /// not configured at acceptance time. The receipt's input shape is
  /// fixed (see service code) so verification is deterministic.
  receiptSignature String?  @map("receipt_signature")
  /// KMS key id used to produce `receiptSignature`. Stored alongside
  /// the signature so a regulator can route Verify to the right key
  /// even after rotations.
  receiptKeyId     String?  @map("receipt_key_id")
  acceptedAt       DateTime @default(now()) @map("accepted_at")

  @@index([userId, acceptedAt])
  @@index([contextType, contextRef])
  @@map("policy_acceptances")
  @@schema("identity")
}

/// AdES-grade DUA signature via self-hosted DocuSeal (#128, ADR-0003
/// Decision 5). One row per Data Use Agreement signing request.
/// Used for `CONTROLLED`-tier access; `OPEN`/`REGISTERED` continue to
/// use click-wrap (#118) which is SES-grade; `SENSITIVE` uses QES
/// (Yousign, future #131).
///
/// Lifecycle: PENDING (created when AR is APPROVED at CONTROLLED tier)
/// → SIGNED (DocuSeal webhook fires) or DECLINED (signer rejected).
///
/// `documentSha256` is computed over the Markdown body rendered by the
/// DUA template engine (#129). Stored so a regulator audit can
/// re-derive the hash from the persisted `documentText` and confirm
/// the signed document is the one the user actually saw.
///
/// `signedPdfUrl` is the DocuSeal-hosted PDF after completion; we
/// don't ingest the PDF bytes (DocuSeal retains them in its volume).
/// On a future evidentiary need the URL resolves to the audit-grade
/// PDF with embedded signature certificate.
///
/// `userId` is a soft FK → identity.users.id. `accessRequestId` is a
/// soft FK → catalog.access_requests.id — the AR this signature
/// authorises. Required: every signature exists in the context of
/// an approved AR.
model DuaSignature {
  id                   String    @id @default(uuid()) @db.Uuid
  /// Soft FK → identity.users.id (UUIDv5 from Cognito sub).
  userId               String    @map("user_id") @db.Uuid
  /// Soft FK → catalog.access_requests.id.
  accessRequestId      String    @map("access_request_id") @db.Uuid
  /// PENDING | SIGNED | DECLINED | EXPIRED.
  status               String    @default("PENDING")
  /// DocuSeal submission id — the canonical reference for inspecting
  /// the envelope state on the DocuSeal side.
  docusealSubmissionId String?   @map("docuseal_submission_id")
  /// URL the signer follows to complete the signing dance.
  signerUrl            String?   @map("signer_url")
  /// Markdown body rendered by the DUA template engine. Persisted
  /// verbatim so a regulator audit can re-verify the hash even if
  /// the template engine drifts later.
  documentText         String    @map("document_text")
  /// Lower-case hex SHA-256 of `documentText`. Audit anchor.
  documentSha256       String    @map("document_sha256") @db.Char(64)
  /// DocuSeal-hosted PDF of the completed envelope.
  signedPdfUrl         String?   @map("signed_pdf_url")
  /// Server-side timestamps.
  createdAt            DateTime  @default(now()) @map("created_at")
  signedAt             DateTime? @map("signed_at")
  declinedAt           DateTime? @map("declined_at")

  @@index([userId, createdAt])
  @@index([accessRequestId])
  @@map("dua_signatures")
  @@schema("identity")
}

// ==========================================================================
// catalog — datasets, Croissant 1.1 / RAI / BIOCroissant manifests,
//            versions, distributions, access requests. (DAP package, WS-1.)
// ==========================================================================
//
// `Dataset` is the canonical record. The latest published Croissant manifest
// lives on `Dataset.croissant` for fast reads; full version history is on
// `DatasetVersion` (immutable rows once published, addressed by content hash).
// `Distribution` rows mirror the FileObject/FileSet entries from the manifest
// so we can resolve them to S3 keys + pre-signed URLs without re-parsing the
// JSON-LD on every request. `AccessRequest` carries the consent / DPIA /
// IRB attestations needed to grant a requester access to RESTRICTED data.
//
// Cross-schema references (host_id, requester_id, etc. → identity.users) are
// kept as soft (UUID) references rather than Prisma relations: Prisma's
// multiSchema preview doesn't model FKs across schemas cleanly, and
// dataset-host bindings are administrative (host accounts can be deactivated
// without deleting their datasets). Phase B may revisit if cross-schema
// FKs prove necessary for cascading.

enum DatasetVisibility {
  PRIVATE
  RESTRICTED
  PUBLIC

  @@schema("catalog")
}

enum DatasetStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED

  @@schema("catalog")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED

  @@schema("catalog")
}

/// Identity assurance tier (#115, ADR-0003 Decision 1). Decoupled from
/// `DatasetVisibility`. `OPEN` keeps existing rows permissive; hosts opt
/// up as they publish more sensitive material.
enum AccessTier {
  OPEN
  REGISTERED
  CONTROLLED
  SENSITIVE

  @@schema("catalog")
}

/// Commercial-use terms on a dataset (#119, ADR-0003 Decision 9). Drives
/// the `/catalog` "Commercial use" filter + badge and the matcher's
/// commercial-vs-NCU verdict. `CASE_BY_CASE` is the conservative default
/// for newly-published datasets; the migration backfills existing rows
/// from any NCU DUO term they declared. GI-AI4H curated datasets are
/// explicitly set to `OK` by the seed script.
enum CommercialUseTerms {
  OK
  NON_COMMERCIAL_ONLY
  CASE_BY_CASE

  @@schema("catalog")
}

/// Audience classification for an access request (#120, ADR-0003 Decision 8).
/// `RESEARCHER` flows assume publication-as-output; `BUILDER` flows assume
/// product-as-output (FDA / EU MDR / national-equivalent regulatory pathway).
/// Both share the same back-end approval state machine + Visa issuance; the
/// difference is in the form template the requester filled and the
/// `builderContext` payload populated for BUILDER rows.
enum AccessRequestAudience {
  RESEARCHER
  BUILDER

  @@schema("catalog")
}

/// Computed identity-assurance score for a requester at access-request
/// creation time (#115, ADR-0003 Decision 2). Persisted on `AccessRequest`
/// so the host inbox can show "what we know about this person" without
/// recomputation. Order is canonical — see `REQUESTER_IDENTITY_SCORE_RANK`
/// in `@oci/shared-types`.
enum RequesterIdentityScore {
  EMAIL_ONLY
  EMAIL_DOMAIN_VERIFIED
  ORCID_LINKED
  QUIZ_PASSED
  PI_COUNTERSIGNED
  PASSPORT_VERIFIED

  @@schema("catalog")
}

/// Where the bytes for a Distribution actually live. PR I (#87) adds
/// `S3` for self-hosted uploads under `oci-datasets-<env>`; everything
/// before PR I was implicitly `EXTERNAL` (the manifest's contentUrl
/// pointed at an upstream host like Kaggle / Grand Challenge). The
/// `EXTERNAL_S3` slot is reserved for the cross-account mount in #89.
enum DistributionStorageBackend {
  EXTERNAL
  S3
  EXTERNAL_S3

  @@schema("catalog")
}

/// Lifecycle marker for self-hosted distributions (storageBackend=S3).
/// EXTERNAL distributions stay at READY by definition.
enum DistributionUploadStatus {
  PENDING
  READY
  FAILED

  @@schema("catalog")
}

model Dataset {
  id                 String                   @id @default(uuid()) @db.Uuid
  /// URL-safe identifier, e.g. "rsna-pneumonia-2018-v1". Unique. Used in
  /// catalog URLs and as the @id base for the Croissant manifest.
  slug               String                   @unique
  /// Human-readable name; mirrors Croissant `sc:name` on the latest version.
  name               String
  description        String?
  /// Soft FK → identity.users.id. The dataset host (admin / steward).
  hostId             String                   @map("host_id") @db.Uuid
  visibility         DatasetVisibility        @default(PRIVATE)
  status             DatasetStatus            @default(DRAFT)
  /// Croissant conformance target of `croissant`, e.g. "1.0", "1.1".
  /// Derived from `dct:conformsTo` at publish time.
  conformanceVersion String?                  @map("conformance_version")
  /// Latest published Croissant 1.1 (+ RAI + BIOCroissant) manifest.
  /// NULL while in DRAFT; populated on transition to PUBLISHED.
  croissant          Json?
  /// PostgreSQL `tsvector` GENERATED column (added by migration
  /// 20260506000001_catalog_search). Drives the
  /// `GET /v2/catalog/datasets?q=...` full-text search via raw SQL
  /// (`@oci/database` exposes a typed `searchDatasets()` helper).
  /// Prisma can't model tsvector natively; we declare it `Unsupported`
  /// so the migration tracks the column without exposing it on the
  /// generated client surface (which would force casts everywhere).
  searchVector       Unsupported("tsvector")? @map("search_vector")

  /// DUO permission term short ids (e.g. "DUO_0000042") extracted from
  /// the latest published manifest's `consentCode` (PR J.1, #93). Empty
  /// when no terms declared. Authoritative source remains the manifest;
  /// this column is a denormalised cache for fast read on the detail
  /// page + the access-request matcher. Re-extracted on each publish.
  duoTerms String[] @default([]) @map("duo_terms")

  /// Modality labels denormalised from the Croissant manifest on
  /// publish (#247). Sourced from BIOCroissant's `bio:imagingModality`
  /// / `bio:dataModality` entries (raw `name` / `termCode` text — no
  /// vocabulary normalisation here). Empty when the host hasn't
  /// declared structured modality metadata.
  ///
  /// Drives the campaign-create form's task-kind constraint (#247) and
  /// the API service guard at `POST /v2/annotation/campaigns`. The
  /// canonical modality → allowed task-kinds map lives in
  /// `@oci/shared-types/modality-task-kinds`. Authoritative source
  /// remains the manifest; this array is a read-cache the same way
  /// `duoTerms` is — re-extracted on each publish.
  modalities String[] @default([]) @map("modalities")

  /// Per-dataset email-domain allowlist (#116, Phase B · DAP). Empty
  /// disables the allowlist; the API then falls back to the heuristic
  /// classifier in `@oci/shared-types/email-domain.ts`. Entries are
  /// either bare domains (`example.org`) or leading-dot wildcards
  /// (`.example.org`); validated on write by the host config endpoint.
  emailDomainAllowlist String[] @default([]) @map("email_domain_allowlist")

  /// Identity-assurance tier (#115, ADR-0003 Decision 1). Decoupled from
  /// `visibility`. Default `OPEN` keeps existing rows permissive; hosts
  /// opt up as they publish more sensitive material. The DUO matcher
  /// surfaces a CONFLICT explanation when the requester's identity score
  /// is below this tier's minimum (`ACCESS_TIER_MIN_SCORE`).
  accessTier AccessTier @default(OPEN) @map("access_tier")

  /// Commercial-use terms (#119, ADR-0003 Decision 9). The matcher reads
  /// this as the source of truth for the commercial-vs-NCU decision —
  /// `OK` permits commercial requests, `NON_COMMERCIAL_ONLY` rejects
  /// them, `CASE_BY_CASE` flags UNCLEAR for host review. Default
  /// `CASE_BY_CASE` is conservative for newly-published datasets; the
  /// migration backfills existing rows from any NCU DUO term they
  /// declared.
  commercialUseTerms CommercialUseTerms @default(CASE_BY_CASE) @map("commercial_use_terms")

  /// Optional host-specified commercial-use clauses (#119). Plain text;
  /// surfaced verbatim on the dataset detail page when commercial terms
  /// require nuance (e.g. "OK with royalty-free LMIC public-sector
  /// deployment"). Null when the host has nothing to add beyond the
  /// `commercialUseTerms` band.
  commercialClauses String? @map("commercial_clauses")

  versions       DatasetVersion[]
  accessRequests AccessRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([visibility, status])
  @@index([hostId])
  @@map("datasets")
  @@schema("catalog")
}

model DatasetVersion {
  id            String  @id @default(uuid()) @db.Uuid
  datasetId     String  @map("dataset_id") @db.Uuid
  /// Semver per the Croissant spec (MAJOR.MINOR.PATCH). Unique per dataset.
  version       String
  croissant     Json
  /// SHA-256 hex of the canonicalised JSON-LD. Used for integrity checks +
  /// as the content address when other systems cite a specific version.
  croissantHash String? @map("croissant_hash")
  notes         String?
  /// Soft FK → identity.users.id. Whoever published this version.
  publishedById String  @map("published_by_id") @db.Uuid

  publishedAt DateTime @default(now()) @map("published_at")

  dataset       Dataset        @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  distributions Distribution[]

  @@unique([datasetId, version])
  @@index([datasetId, publishedAt])
  @@map("dataset_versions")
  @@schema("catalog")
}

model Distribution {
  id               String  @id @default(uuid()) @db.Uuid
  datasetVersionId String  @map("dataset_version_id") @db.Uuid
  /// `@id` of the FileObject / FileSet inside the Croissant manifest. Stable
  /// across versions only when the content + filename are stable.
  croissantId      String  @map("croissant_id")
  contentUrl       String? @map("content_url")
  contentType      String  @map("content_type")
  contentSizeBytes BigInt? @map("content_size_bytes")
  /// Lower-case hex sha256.
  contentHash      String? @map("content_hash_sha256")
  /// True when an AccessRequest must be APPROVED before contentUrl is minted
  /// (S3 pre-signed) for the requester. Mirrors the dataset's RESTRICTED
  /// visibility but per-distribution so a dataset can mix public + restricted
  /// distributions (e.g. metadata-only public, full DICOMs restricted).
  requiresAccess   Boolean @default(false) @map("requires_access")

  /// Where the bytes live. EXTERNAL = the manifest's contentUrl is
  /// authoritative (upstream host, like the IDRiD seed). S3 = we
  /// host the bytes under oci-datasets-<env>; the download path
  /// goes through `/v2/catalog/datasets/:slug/distributions/:id/
  /// download` which 302s to a presigned GET URL.
  storageBackend DistributionStorageBackend @default(EXTERNAL) @map("storage_backend")
  /// Bucket name for storageBackend=S3. Captured at upload time so
  /// rotating bucket names later doesn't break existing rows.
  s3Bucket       String?                    @map("s3_bucket")
  /// S3 key, e.g. `<dataset-slug>/<uuid>/<filename>`. Null for
  /// EXTERNAL.
  s3Key          String?                    @map("s3_key")
  /// PENDING → S3 multipart in flight; READY → complete + downloadable;
  /// FAILED → multipart aborted, row should be GC'd. Null/READY for
  /// EXTERNAL rows (they never went through our upload pipeline).
  uploadStatus   DistributionUploadStatus?  @map("upload_status")

  datasetVersion DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, croissantId])
  @@index([storageBackend, uploadStatus])
  @@map("distributions")
  @@schema("catalog")
}

/// Result of auto-matching the requester's intended use against the
/// dataset's DUO permission terms (PR J.1, #93). NULL on legacy rows
/// from before the matcher shipped.
enum AccessRequestMatchStatus {
  MATCHED
  CONFLICT
  UNCLEAR

  @@schema("catalog")
}

model AccessRequest {
  id            String              @id @default(uuid()) @db.Uuid
  datasetId     String              @map("dataset_id") @db.Uuid
  /// Soft FK → identity.users.id.
  requesterId   String              @map("requester_id") @db.Uuid
  justification String
  status        AccessRequestStatus @default(PENDING)
  /// Set when status leaves PENDING.
  decidedAt     DateTime?           @map("decided_at")
  /// Soft FK → identity.users.id. Host or admin who APPROVED/DENIED/REVOKED.
  decidedById   String?             @map("decided_by_id") @db.Uuid
  decisionNote  String?             @map("decision_note")
  /// Structured intended-use attestations (PR J.1, #93). Replaces the v0
  /// placeholder shape; AccessRequestAttestationsSchema in
  /// `@oci/shared-types` is the source of truth. Validated on insert by
  /// the API; legacy rows from PR F (#75) read with a permissive parser.
  ///
  /// v1 shape:
  ///   { v: 1, projectTitle, projectDescription, institution,
  ///     intendedUseCategory, intendedUseDuoTerms[],
  ///     irbApproved, irbApprovalRef?, dpiaRef?, dataRetentionDays,
  ///     redistributionIntent, outputType }
  attestations  Json?

  /// Auto-match decision. Set by the API when the request is created
  /// from the requester's DUO terms + dataset DUO terms. The host
  /// inbox renders this as a badge; null = legacy / not matched.
  matchStatus       AccessRequestMatchStatus? @map("match_status")
  /// Human-readable matcher findings. Empty array when MATCHED;
  /// populated for CONFLICT / UNCLEAR so the host sees the *why*
  /// without having to learn DUO themselves.
  matchExplanations String[]                  @default([]) @map("match_explanations")

  /// Computed at create time from the `RequesterIdentityContext`
  /// normalizer (#115, ADR-0003 Decision 2). Default `EMAIL_ONLY` keeps
  /// legacy rows valid post-migration; new rows pick up
  /// `EMAIL_DOMAIN_VERIFIED` when the requester's email is institutional
  /// or corporate (#116). Future PRs lift toward `QUIZ_PASSED` (#117),
  /// `PI_COUNTERSIGNED` (DUA flow), and `PASSPORT_VERIFIED` (Passport
  /// ingestion).
  requesterIdentityScore RequesterIdentityScore @default(EMAIL_ONLY) @map("requester_identity_score")

  /// Audience classification (#120, ADR-0003 Decision 8). Derived at
  /// create time from `attestations.intendedUseCategory` —
  /// `COMMERCIAL_RESEARCH` and `CLINICAL_CARE` route to `BUILDER`,
  /// everything else routes to `RESEARCHER`. The host inbox uses this
  /// to pick the right reviewer template; both flows share the same
  /// state machine (PENDING → APPROVED | DENIED | REVOKED).
  audience AccessRequestAudience @default(RESEARCHER) @map("audience")

  /// AI-builder-specific context (#120). Populated only when
  /// `audience=BUILDER`. Schema (see `BuilderContextSchema` in
  /// `@oci/shared-types`):
  ///   { legalEntity, deploymentCountries[], regulatoryPathway,
  ///     whoPriorityAlignment?, accreditations[], royaltyPlan?,
  ///     postMarketDataFlow }
  /// Null for RESEARCHER rows.
  builderContext Json? @map("builder_context")

  /// Intended Data Use statement (#115). Replaces `justification` as
  /// the canonical free-text rationale. Backfilled from `justification`
  /// on existing rows by the migration; new rows mirror
  /// `attestations.projectDescription` here during the transition.
  /// Nullable for legacy rows that never had a justification value.
  iduStatement String? @map("idu_statement")

  /// Optional AI-tool transparency disclosure (#115). Schema:
  /// `{ tools: [{ name, usage }], notes? }` — see `AiToolDisclosureSchema`
  /// in `@oci/shared-types`. Populated by #120 (builder/researcher form
  /// variants) when the requester declares AI tooling used in the project.
  aiToolDisclosure Json? @map("ai_tool_disclosure")

  /// PI / Signing Official email for CONTROLLED+ tier countersign
  /// workflows (#115). `null` until the form captures it (#120) and the
  /// DUA flow uses it (future PR alongside DocuSeal AdES integration).
  signingOfficialEmail String? @map("signing_official_email")

  /// Timestamp when the requester accepted the data-use pledge / click-
  /// wrap (#118). `null` on existing rows; populated when #118 lands the
  /// click-wrap component on the request-access page.
  pledgeAcceptedAt DateTime? @map("pledge_accepted_at")

  /// Renewal lifecycle (#130, ADR-0003 Phase 2). `expiresAt` is set on
  /// the APPROVED transition to `decidedAt + OCI_ACCESS_GRANT_VALIDITY_DAYS`
  /// (default 365). The renewal cron auto-revokes APPROVED rows whose
  /// `expiresAt` has passed; renewals extend the timestamp instead of
  /// creating a new row. Null on PENDING / DENIED / REVOKED rows.
  expiresAt DateTime? @map("expires_at")

  /// Set the first time the renewal cron emits a 30-day pre-expiry
  /// notice for this row. Used as a deduplication guard so the cron
  /// running daily doesn't spam the requester.
  expiryNoticeSentAt DateTime? @map("expiry_notice_sent_at")

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([datasetId, status])
  @@index([datasetId, status, matchStatus])
  @@index([requesterId, status])
  /// Renewal cron's primary read path (#130).
  @@index([status, expiresAt])
  @@map("access_requests")
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Federation (Phase E down-payment, PR E.1)
//
// `RemoteCatalog` rows are admin-managed peer Croissant catalogues we
// federate from. The harvest job (apps/worker-ingest, scheduled in PR
// E.3) iterates over these rows, fetches the peer's
// `.well-known/croissant-catalog.json`, and upserts the manifests it
// finds into a `RemoteDataset` table (added in PR E.2 alongside the
// `?source=federated` filter on `/v2/catalog/datasets`).
//
// PR E.1 ships only the admin surface for managing these rows — see
// `apps/api/src/modules/remote-catalog/`. Until PR E.3 lands the
// worker, every row's `lastHarvestedAt` stays null and `harvestStatus`
// stays IDLE.
// ---------------------------------------------------------------------------

enum HarvestStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("catalog")
}

model RemoteCatalog {
  id          String  @id @default(uuid()) @db.Uuid
  /// URL-safe identifier (e.g. "huggingface", "gi-ai4h-thailand").
  slug        String  @unique
  name        String
  /// Base URL of the peer's catalog. The harvester appends
  /// `/.well-known/croissant-catalog.json` to enumerate datasets.
  endpointUrl String  @map("endpoint_url")
  description String?

  harvestStatus   HarvestStatus @default(IDLE) @map("harvest_status")
  /// Set by the worker on each run; null until the worker has run.
  lastHarvestedAt DateTime?     @map("last_harvested_at")
  /// Last error message from a FAILED run.
  lastError       String?       @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  datasets RemoteDataset[]

  @@index([harvestStatus])
  @@map("remote_catalogs")
  @@schema("catalog")
}

/// Mirror of a dataset harvested from a `RemoteCatalog`. PR E.2 ships
/// this model + the read-path (`?source=federated|all`); the harvest
/// worker that actually populates the rows lands in PR E.3.
///
/// Why a separate table from `Dataset`:
///   - Federated rows have no local host or version history; the
///     authoritative copy is upstream. Conflating them with locally
///     published datasets would force every consumer query to know
///     which rows are "real" vs. mirrored.
///   - Slugs may collide across peers (HuggingFace + OpenML can both
///     have `imdb-reviews`); the unique key is `(sourceCatalogId,
///     originUrl)` not `slug`.
///   - Detail is read upstream (the card click follows `originUrl`);
///     no need to mirror version + distribution history locally.
///
/// `croissant` carries the full JSON-LD manifest as harvested. The
/// worker validates it via `@oci/croissant` before writing, so any
/// row that lands here is at minimum Croissant 1.0/1.1 conformant.
model RemoteDataset {
  id              String @id @default(uuid()) @db.Uuid
  sourceCatalogId String @map("source_catalog_id") @db.Uuid

  /// The peer's `@id` for this dataset. Used as the upsert key
  /// alongside sourceCatalogId. Stable across re-harvests.
  originUrl String @map("origin_url")

  /// Denormalised from the manifest. Not unique globally — a peer
  /// might publish the same slug as us or as another peer.
  slug               String
  name               String
  description        String?
  /// "1.0", "1.1", or "unknown" (matches Dataset.conformanceVersion).
  conformanceVersion String? @map("conformance_version")
  /// Manifest version string (sc:version), if present.
  version            String?

  /// Full JSON-LD manifest as harvested. Kept verbatim so the upstream
  /// host's signature / formatting isn't mangled.
  croissant Json

  harvestedAt DateTime @default(now()) @map("harvested_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sourceCatalog RemoteCatalog @relation(fields: [sourceCatalogId], references: [id], onDelete: Cascade)

  @@unique([sourceCatalogId, originUrl])
  @@index([sourceCatalogId, harvestedAt])
  @@map("remote_datasets")
  @@schema("catalog")
}

// ==========================================================================
// annotation — campaigns, tasks, tool-integration registry (AP package)
// Phase B.A.1 lands the Campaign entity + a minimal AnnotationToolIntegration
// stub registry (full contract per ADR-0007 lands as sub-epic #214). Task,
// TaskAssignment, Annotation, audit event log land in Phase B.A.2+ per
// ADR-0006/0008/0009.
// ==========================================================================

/// Annotation-tool adapter registry stub (sub-epic #214 will replace this
/// with the full typed capability matrix + versioned schemaProfile per
/// ADR-0007). Phase B.A.1 seeds two stub rows (`monai-label`, `visian`)
/// so the campaign-create UI has tool options to bind to.
model AnnotationToolIntegration {
  id                 String             @id @default(uuid()) @db.Uuid
  /// URL-safe identifier, e.g. "monai-label". Unique.
  slug               String             @unique
  name               String
  vendor             String
  /// Latest semver of the adapter (per ADR-0007 versioning).
  version            String
  isActive           Boolean            @default(true) @map("is_active")
  /// Task kinds this tool can handle. Used to filter the tool picker
  /// on `/annotation/campaigns/new` after a task kind is selected
  /// (user feedback 2026-05-16). The full per-task capability matrix
  /// from ADR-0007 (containers, signed-handoff routes, schemaProfiles)
  /// lands with #214; this column is the minimum to make the picker
  /// safe today.
  supportedTaskKinds CampaignTaskKind[] @map("supported_task_kinds")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  campaigns AnnotationCampaign[]

  @@map("annotation_tool_integrations")
  @@schema("annotation")
}

/// Annotation campaign — the unit of orchestration for the 3-gate SOP
/// (ADR-0006 Decision 3). Phase B.A.1 only writes DRAFT status; the
/// state machine (ADR-0006 + ADR-0011) lands with sub-epic #215.
///
/// Foreign keys per ADR-0006 Decision 6: `datasetId` references
/// catalog.datasets.id; `toolIntegrationId` references the registry
/// above. Both are validated at insert time; full FK with cascade
/// policy lands when the related schemas are connected at the Prisma
/// level (Phase B.A.2 / B.A.3).
model AnnotationCampaign {
  id          String           @id @default(uuid()) @db.Uuid
  /// URL-safe identifier, unique within campaigns. Same shape as Dataset.slug.
  slug        String           @unique
  name        String
  description String?
  status      CampaignStatus   @default(DRAFT)
  taskKind    CampaignTaskKind @map("task_kind")

  /// Soft FK → catalog.datasets.id (ADR-0006 Decision 6). Hard FK lands
  /// in B.A.2 along with manifest-version pinning.
  datasetId         String @map("dataset_id") @db.Uuid
  /// Real FK to annotation_tool_integrations.id.
  toolIntegrationId String @map("tool_integration_id") @db.Uuid

  /// Output license for the resulting annotation distribution (ADR-0012
  /// Decision 3). SPDX identifier or `custom-restricted`. Immutable
  /// once status transitions out of DRAFT.
  outputLicense CampaignOutputLicense @map("output_license")

  /// JSONB workflow config (ADR-0009 Decisions 2 + 4). Phase B.A.1 only
  /// stores `{ nAnnotators: number }`. Full shape per ADR-0009 lands
  /// with E4 (#216).
  workflowConfig Json @map("workflow_config")

  /// JSONB metadata-visibility config (ADR-0010 Decisions 1 + 2). The
  /// four-bucket field overrides (required/optional/hidden/never) +
  /// per-gate promotions + `trainingGrade` flag, versioned by content
  /// hash. Null until the campaign manager configures visibility; the
  /// engine then falls back to the dataset's Croissant
  /// `oci:annotationVisibility` tags and the OCI default visibility
  /// table. The `never` bucket (PHI / direct identifiers) is always
  /// server-side filtered regardless of this config.
  visibilityConfig Json? @map("visibility_config")

  /// Soft FK → identity.users.id. The campaign manager who created it.
  createdById String @map("created_by_id") @db.Uuid

  /// Pointer to the currently-published `CampaignInstructions` version
  /// for this campaign (#230). Null while no instructions are attached.
  /// Cached on the campaign row so annotator pulls don't have to join
  /// the instructions table on every read.
  currentInstructionsVersion String? @map("current_instructions_version")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// Set when the campaign transitions to RUNNING (#215, slice 1).
  /// Null while DRAFT / READY / ARCHIVED-before-start; persists once
  /// set so completed campaigns retain the start timestamp.
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  toolIntegration AnnotationToolIntegration        @relation(fields: [toolIntegrationId], references: [id])
  instructions    AnnotationCampaignInstructions[]

  @@index([status])
  @@index([datasetId])
  @@index([createdById])
  @@map("annotation_campaigns")
  @@schema("annotation")
}

/// Per-campaign instructions (#230). Versioned by sha256 of the
/// markdown body so identical content never produces a new row. The
/// `campaign.currentInstructionsVersion` pointer references whichever
/// version is currently "published" to annotators.
///
/// Markdown is sanitised on render (frontend); the API stores raw
/// markdown. `mediaUrls` is a free-form JSON array — captured at
/// publish time so the auditor can reproduce what the annotator saw.
model AnnotationCampaignInstructions {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId   String   @map("campaign_id") @db.Uuid
  /// Short hex slice of the sha256 of `markdownBody` (16 chars).
  /// Stable across re-publishes of identical content; the
  /// `(campaignId, version)` unique index drops duplicate publishes.
  version      String
  /// Raw markdown. Capped at 64KB at the API layer.
  markdownBody String   @map("markdown_body")
  /// JSON array of {url, kind} entries the markdown references.
  mediaUrls    Json     @map("media_urls")
  /// Soft FK → identity.users.id. Same convention as
  /// `AnnotationCampaign.createdById`.
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  campaign AnnotationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, version])
  @@index([campaignId, createdAt])
  @@map("annotation_campaign_instructions")
  @@schema("annotation")
}

enum CampaignStatus {
  DRAFT
  READY
  RUNNING
  COMPLETED
  ARCHIVED

  @@schema("annotation")
}

enum CampaignTaskKind {
  CLASSIFICATION
  DETECTION
  SEGMENTATION
  LOCALIZATION
  MULTI_MODAL

  @@schema("annotation")
}

enum CampaignOutputLicense {
  CC_BY_4_0         @map("CC-BY-4.0")
  CC_BY_NC_4_0      @map("CC-BY-NC-4.0")
  CC_BY_SA_4_0      @map("CC-BY-SA-4.0")
  CC0_1_0           @map("CC0-1.0")
  CUSTOM_RESTRICTED @map("custom-restricted")

  @@schema("annotation")
}

/// 3-gate SOP gate state per annotation task (#215 slice 2, ADR-0006
/// Decision 3 + ADR-0008 §IRR thresholds + ADR-0011 sample rejection).
///
/// Flow (slice-2 minimum — IRR threshold checks at gate-1 are slice 3):
///   INDEPENDENT → AWAITING_ARBITRATION (after N independent submissions)
///   INDEPENDENT → COMPLETED            (N=1 single-rater shortcut)
///   AWAITING_ARBITRATION → AWAITING_EXPERT (escalation)
///   AWAITING_ARBITRATION → COMPLETED   (arbitration submission ends it)
///   AWAITING_EXPERT → COMPLETED        (expert review is FINAL per ADR-0008)
///   any → SKIPPED                      (operator override; reason required)
enum AnnotationGateState {
  INDEPENDENT
  AWAITING_ARBITRATION
  AWAITING_EXPERT
  COMPLETED
  SKIPPED

  @@schema("annotation")
}

/// One row per (campaign × sample). Holds the gate-state pointer for
/// the 3-gate SOP. Slice 2 of #215 seeds tasks via an explicit
/// `sampleRefs` array on the seed endpoint; in slice 3 the seed will
/// pull the references from the dataset manifest under the
/// catalog ↔ annotation linkage being added in #223 (E11).
///
/// `sampleRef` is intentionally opaque — actual sample retrieval goes
/// through the tool-integration's signed handoff URL (ADR-0007 / #214).
/// The task model carries only the pointer + the gate state.
model AnnotationTask {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId          String              @map("campaign_id") @db.Uuid
  /// Stable, campaign-scoped identifier for the underlying sample.
  /// Free-form string today; will be constrained to dataset
  /// `recordSet/record` URIs once #223 lands.
  sampleRef           String              @map("sample_ref")
  /// Denormalised at create time from `campaign.workflowConfig.nAnnotators`
  /// so the gate-completion check doesn't have to re-read the campaign.
  /// Mutating the campaign workflow after RUNNING is intentionally
  /// not in scope — change → clone instead.
  nAnnotatorsRequired Int                 @map("n_annotators_required")
  gateState           AnnotationGateState @default(INDEPENDENT) @map("gate_state")
  /// Operator-supplied reason for SKIPPED transitions; null otherwise.
  skipReason          String?             @map("skip_reason")
  /// Optional per-task instructions override (#230). Free-form
  /// markdown shown alongside the campaign-level instructions when
  /// the sample needs special-attention notes. Capped at 4KB at the
  /// API layer.
  instructionsNote    String?             @map("instructions_note")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  completedAt         DateTime?           @map("completed_at")

  assignments AnnotationTaskAssignment[]

  @@unique([campaignId, sampleRef])
  @@index([campaignId, gateState])
  @@map("annotation_tasks")
  @@schema("annotation")
}

/// Status of an annotator's work on a task at a given gate.
///   PENDING     — assignment row exists, annotator hasn't started
///   IN_PROGRESS — annotator opened the task (signed handoff issued)
///   SUBMITTED   — annotator persisted their submission; counts toward
///                 the gate-completion check
///   EXPIRED     — abandonment timeout (#229) freed the assignment
enum AnnotationAssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  EXPIRED

  @@schema("annotation")
}

/// One row per (task × annotator × gate). Tracks the assignment
/// lifecycle so the router can re-issue work after expiry without
/// double-counting submissions.
///
/// Slice-2 routing implements predicate 1 (role match) + predicate 6
/// (FIFO tiebreaker) from ADR-0009 Decision 1. Experience-weighted
/// ranking, bias-prevention sampling, stratification, and the
/// calibration loop are slice 3+.
///
/// `assigneeRole` is snapshotted at assignment time so a later change
/// to the annotator's group memberships doesn't retroactively
/// invalidate a submission already in flight.
model AnnotationTaskAssignment {
  id                              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId                          String                     @map("task_id") @db.Uuid
  /// Soft FK → identity.users.id (matches the existing campaign-side
  /// `createdById` convention). Stored as the v5-derived UUID of the
  /// caller's Cognito sub, per `cognitoSubAsUuid()`.
  assigneeUserId                  String                     @map("assignee_user_id") @db.Uuid
  /// Cognito group at assignment time. Slice 2 supports:
  /// 'annotator' | 'arbitration-annotator' | 'expert-reviewer'.
  assigneeRole                    String                     @map("assignee_role")
  /// Snapshot of `task.gateState` at assignment time. The submission
  /// pipeline cross-checks this against the live gateState before
  /// counting the submission, so a stale assignment from a previous
  /// gate is rejected with 409.
  gateAtAssignment                AnnotationGateState        @map("gate_at_assignment")
  status                          AnnotationAssignmentStatus @default(PENDING)
  /// Free-form JSONB submission payload. Slice 2 stores whatever the
  /// caller passes; tool-integration-aware schema validation per
  /// ADR-0007 lands with #214 / #231.
  submission                      Json?
  /// Campaign-instructions version the annotator acknowledged at
  /// submission time (#230). Captured into the annotation provenance
  /// alongside `tool_version` / `schema_version`. Null until the
  /// annotator submits with an explicit acknowledgement.
  acknowledgedInstructionsVersion String?                    @map("acknowledged_instructions_version")
  /// What the annotator actually saw at annotation time (ADR-0010
  /// Decision 4): `{ visibilityConfigHash, visibilityConfigVersion,
  /// deliveredFields }`. Captured server-side at handoff so the
  /// regulator-facing "what did the annotator see for this annotation?"
  /// question is answerable per (task × annotator × gate). Null for
  /// assignments issued before the metadata-exposure engine landed, or
  /// while the campaign has no catalog-linked sample metadata (pre-#223).
  metadataExposureProfile         Json?                      @map("metadata_exposure_profile")
  assignedAt                      DateTime                   @default(now()) @map("assigned_at")
  startedAt                       DateTime?                  @map("started_at")
  submittedAt                     DateTime?                  @map("submitted_at")
  expiredAt                       DateTime?                  @map("expired_at")

  task AnnotationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// One annotator can hold at most one ACTIVE assignment per
  /// (task, gate). The partial unique index in the migration enforces
  /// the constraint excluding SUBMITTED / EXPIRED rows so re-assignment
  /// after abandonment isn't blocked.
  @@index([taskId, status])
  @@index([assigneeUserId, status])
  @@index([taskId, gateAtAssignment, status])
  @@map("annotation_task_assignments")
  @@schema("annotation")
}

/// Calibration drift flags per annotator (#292, ADR-0009 Decision 4 + 5).
///
/// One ACTIVE row at a time per (campaignId, annotatorUserId, flagType).
/// The periodic recompute (`calibration.service.ts`) raises a flag when
/// the rolling-window metric crosses the configured threshold and
/// auto-clears the row when the metric recovers. CLEARED rows are kept
/// for audit; the supervisor inbox surfaces only ACTIVE rows.
///
/// `flagType`:
///   - `SKILL`  — IRR vs gold OR vs peers fell below the publishable
///                floor → annotator is auto-suspended pending review.
///   - `DRIFT`  — IRR vs self (test-retest) below fatigue threshold
///                despite acceptable peer/gold scores → schedule
///                recalibration window.
model AnnotatorCalibrationFlag {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId      String    @map("campaign_id") @db.Uuid
  annotatorUserId String    @map("annotator_user_id") @db.Uuid
  flagType        String    @map("flag_type") /// 'SKILL' | 'DRIFT'
  /// Which metric tripped the flag — 'vs-gold' | 'vs-peers' | 'vs-self'.
  metric          String
  /// Numeric value of the metric at flag-raise time (κ, Dice, …).
  score           Float
  /// Threshold the metric was compared against.
  threshold       Float
  /// Number of submissions evaluated in the rolling window.
  sampleSize      Int       @map("sample_size")
  status          String    @default("ACTIVE") /// 'ACTIVE' | 'CLEARED'
  /// Free-form JSONB capturing the window definition (since / until /
  /// task-kind) for audit reproducibility.
  windowMeta      Json      @map("window_meta")
  createdAt       DateTime  @default(now()) @map("created_at")
  clearedAt       DateTime? @map("cleared_at")

  @@index([campaignId, status])
  @@index([annotatorUserId, status])
  /// The partial unique index `(campaignId, annotatorUserId, flagType)
  /// WHERE status = 'ACTIVE'` is created in the migration SQL; Prisma's
  /// `@@unique` doesn't support partial predicates so we rely on the
  /// service-layer SELECT-then-INSERT for the typed read path.
  @@map("annotator_calibration_flags")
  @@schema("annotation")
}

/// Audit log for admin group grants / revokes (#241). One row per
/// administrative action against `cognito-idp:AdminAddUserToGroup` /
/// `AdminRemoveUserFromGroup`. The admin user-management UI reads the
/// last N entries for a given target to show change history.
///
/// `actorSub` and `targetSub` are deterministic v5 UUIDs of the Cognito
/// subs (same convention as other identity-schema rows — see
/// `cognitoSubAsUuid` in `apps/api/src/auth/cognito-sub.ts`). Username
/// + email are cached at write-time so the UI can render history even
/// after a user is renamed / deleted upstream.
///
/// `groupName` is a free string — we don't FK to a groups table because
/// Cognito itself is the source of truth for group definitions. The
/// `PlatformGroupSchema` in `@oci/shared-types` is the curated UI list.
model IdentityAdminAuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorSub       String   @map("actor_sub") @db.Uuid
  actorUsername  String   @map("actor_username")
  targetSub      String   @map("target_sub") @db.Uuid
  targetUsername String   @map("target_username")
  action         String /// 'grant' | 'revoke'
  groupName      String   @map("group_name")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([targetSub, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("identity_admin_audit_events")
  @@schema("identity")
}

/// Cross-cutting platform settings (#242). Single-row table — the
/// fixed `key='current'` unique constraint enforces the singleton
/// shape so any admin write replaces, never inserts in parallel.
///
/// `value` is JSONB so we can grow the settings surface (maintenance
/// banner today; #214 tool registry + #235 phase 2 license defaults
/// next) without a migration per addition. The shape is validated by
/// `PlatformSettingsSchema` in `@oci/shared-types` at the API
/// boundary.
///
/// `lastUpdatedBySub` is the v5 UUID of the admin who applied the
/// most recent change (matches `cognitoSubAsUuid` convention used in
/// the catalog + annotation modules); the username is cached for UI
/// display.
model PlatformSetting {
  key                   String   @id /// always 'current'
  value                 Json
  lastUpdatedBySub      String?  @map("last_updated_by_sub") @db.Uuid
  lastUpdatedByUsername String?  @map("last_updated_by_username")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
  @@schema("platform")
}

/// Platform-wide append-only audit feed (ADR-0014, #257).
///
/// Modules call `@oci/audit`'s `emit` / `emitSync` at the boundary of
/// every persisted state change. Rows are immutable in Postgres: a
/// BEFORE UPDATE trigger raises on any mutation, and the BEFORE DELETE
/// trigger raises except when the retention sweeper (a SECURITY
/// DEFINER role) deletes rows past their retention horizon.
///
/// `previousHash` + `recordHash` form a global hash chain across the
/// stream — see the BEFORE INSERT trigger in the migration for the
/// canonical serialization (pipe-delimited, sha256 over pgcrypto). The
/// verification Lambda + regulator export are Phase C follow-ups
/// (#259); this issue lands the table, the triggers, and the emitter.
model AuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at")
  emittedAt      DateTime @default(now()) @map("emitted_at")
  sequenceNumber BigInt   @default(autoincrement()) @map("sequence_number")
  module         String
  action         String
  subjectType    String   @map("subject_type")
  subjectId      String   @map("subject_id")
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorRoles     String[] @default([]) @map("actor_roles")
  payload        Json
  payloadHash    String   @map("payload_hash") /// sha256 of RFC 8785 canonical JSON of `payload`
  previousHash   String?  @map("previous_hash") /// recordHash of the row with the immediately preceding sequence_number; trigger-populated
  recordHash     String   @map("record_hash") /// sha256 over the pipe-delimited canonical form; trigger-populated
  retentionClass String   @default("standard-7y") @map("retention_class") /// 'short-1y' | 'standard-7y' | 'legal-hold'

  @@index([subjectType, subjectId, occurredAt])
  @@index([module, action, occurredAt])
  @@index([sequenceNumber])
  @@map("audit_events")
  @@schema("platform")
}
