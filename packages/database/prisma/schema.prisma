// OCI Platform — Prisma schema
// Phase A scaffold: single-schema seed.
// Phase A1 migration plan:
//  - Move to Prisma 7 + prisma.config.ts + @prisma/adapter-pg
//  - Re-introduce multi-schema layout (identity / catalog / annotation /
//    prediction / evaluation / reporting) once the adapter pattern is proven.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==== identity (DP package, WS-2) =========================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  cognitoId String   @unique @map("cognito_id")
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ==== catalog (DAP package, WS-1) =========================================

model Dataset {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  // Croissant manifest stored alongside structured metadata
  croissant   Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("datasets")
}

// Phase B will port: annotation, prediction, evaluation, reporting models
// from the legacy annotation-tool / Django EvalAI schemas.
