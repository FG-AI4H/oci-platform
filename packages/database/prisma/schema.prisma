// OCI Platform — Prisma schema (Prisma 7 + multi-schema).
//
// Connection URL is supplied via `prisma.config.ts` (Migrate / Studio) and
// via `@prisma/adapter-pg` at application runtime (PrismaClient). The
// schema no longer embeds the `url` field — Prisma 7 dropped that.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "catalog", "annotation", "prediction", "evaluation", "reporting"]
}

// ==========================================================================
// identity — users, roles, organizations (DP package, WS-2)
// ==========================================================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  cognitoId String   @unique @map("cognito_id")
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@schema("identity")
}

// ==========================================================================
// catalog — datasets, Croissant metadata, data-access requests (DAP, WS-1)
// ==========================================================================

model Dataset {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  // BIOCroissant manifest stored alongside structured metadata
  croissant   Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("datasets")
  @@schema("catalog")
}

// Phase B will port full models for: annotation, prediction,
// evaluation, reporting from the legacy annotation-tool / EvalAI schemas.
