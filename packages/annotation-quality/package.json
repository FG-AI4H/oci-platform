{
  "name": "@oci/annotation-quality",
  "version": "0.0.0",
  "private": true,
  "description": "Inter-rater reliability metrics for annotation campaigns (ADR-0008). Pure functions — no DB, no Prisma; consumed by the workflow engine at decision-box time.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "vitest": "^4.1.5"
  }
}
