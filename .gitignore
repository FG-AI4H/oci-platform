# Dependencies
# Both forms on purpose: the trailing-slash pattern ignores the directory, but
# NOT a symlink of the same name — a `ln -s` into a worktree therefore slipped
# past `git add -A` and got committed as ten mode-120000 blobs. The bare pattern
# catches that too.
node_modules
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
!.env.example

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
ux-screenshots/

# CDK
infra/cdk/cdk.out/
infra/cdk/cdk.context.json

# Prisma generated client (regenerate with `pnpm --filter @oci/database build`)
packages/database/src/generated/

# Secrets / local-only
*.pem
*.key
.aws/

# Local-only AI tooling
.claude/
CLAUDE.md

# Internal companion repo (FG-AI4H/oci-platform-internal — private).
# Wire up via `./scripts/setup-internal.sh` after cloning. Matches
# both real directories (legacy) and symlinks created by the script.
docs/briefings
docs/research
docs/planning
